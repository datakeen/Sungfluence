{
  "name": "sungfluence",
  "productName": "SungFluence",
  "version": "3.4.1",
  "description": "A small design studio that turns images into art made of letters: word portraits, text along lines, ASCII, Braille, calligrams, plus photo, vector and text tools.",
  "main": "main.js",
  "author": {
    "name": "Ahmed Bilal",
    "url": "https://www.linkedin.com/in/abilal/"
  },
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/datakeen/Sungfluence",
  "keywords": [
    "ascii-art",
    "text-art",
    "typography",
    "word-art",
    "calligram",
    "braille",
    "image-to-text",
    "electron"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "build:single": "node scripts/build.js --single",
    "prestart": "node scripts/build.js",
    "start": "electron .",
    "web": "npx --yes http-server src -p 8080 -c-1",
    "test": "node tests/notices.test.js && node tests/regression.test.js && node tests/plugins.test.js && node tests/studio.test.js && node tests/effects.test.js && node tests/commands.test.js && node tests/export.test.js && node tests/output.test.js && node tests/motion.test.js && node tests/type.test.js && node tests/cloud.test.js && node tests/turn.test.js && node tests/marks.test.js && node tests/words.test.js && node tests/wall.test.js && node tests/flip.test.js && node tests/office.test.js && node tests/size.test.js && node tests/styles.test.js && node tests/photo.test.js && node tests/snap.test.js && node tests/vector.test.js && node tests/paper.test.js && node tests/fill.test.js && node tests/firstlook.test.js && node tests/mirror.test.js && node tests/shared.test.js && node tests/panel.test.js && node tests/firstpick.test.js && node tests/flagship.test.js && node tests/cloudgrid.test.js && node tests/rulers.test.js && node tests/checkup.test.js && node tests/transparency.test.js && node tests/site.test.js && node tests/artboard.test.js",
    "predist": "node scripts/build.js",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "vendor": "node scripts/vendor.js",
    "icons": "node scripts/icons.js",
    "test:smoke": "node tests/smoke.test.js",
    "test:rulers": "node tests/rulers.test.js",
    "help:shots": "node scripts/help-shots.js",
    "docs": "node scripts/docs.js",
    "site": "node scripts/site.js",
    "site:serve": "node scripts/site.js --serve",
    "site:images": "node scripts/site-images.js",
    "test:site": "node tests/site.test.js",
    "test:notices": "node tests/notices.test.js"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jspdf": "^2.5.1",
    "jszip": "^3.10.1",
    "playwright": "^1.48.2"
  },
  "build": {
    "appId": "io.github.datakeen.sungfluence",
    "productName": "SungFluence",
    "copyright": "Copyright (C) 2026 Ahmed Bilal and contributors. Free and open source software under the GNU AGPL v3 or later.",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "LICENSE",
      "src/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "SungFluence-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "SungFluence-Setup-${version}-${arch}.${ext}",
      "license": "LICENSE",
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "SungFluence-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon-mac.png",
      "extraResources": [
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "LICENSE.electron.txt"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "LICENSES.chromium.html"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Graphics",
      "icon": "build/icons",
      "maintainer": "Ahmed Bilal",
      "synopsis": "Turn photos into typographic art",
      "executableName": "sungfluence"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "publish": [
      {
        "provider": "github",
        "publishAutoUpdate": false
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/datakeen/Sungfluence.git"
  },
  "bugs": {
    "url": "https://github.com/datakeen/Sungfluence/issues"
  }
}
